# ============================================
# 환경 변수 예시 파일
# 실제 사용 시 .env.local 로 복사 후 값 입력
# ============================================

# ----- AI 이미지 생성 API (현재는 mock 모드) -----
# IMAGE_AI_PROVIDER 값에 따라 사용할 AI 프로바이더가 정해짐
# 가능한 값: mock | gemini | openai | replicate
IMAGE_AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# ----- 토스페이먼츠 (휴대폰/네이버페이/카카오페이/삼성페이/애플페이 통합) -----
# 테스트 키는 토스페이먼츠 개발자센터에서 발급
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# ----- Supabase (DB / Storage / Auth) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- 결제 모드 -----
# mock 이면 결제 없이 통과 (개발용), real 이면 토스페이먼츠 호출
PAYMENT_MODE=mock

# ----- 가격 -----
NEXT_PUBLIC_PRICE_KRW=4900
